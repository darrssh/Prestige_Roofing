# Copy this file to `.env` and adjust for your deployment target.
#
# GitHub Pages PROJECT site (default):
#   PUBLIC_SITE_URL=https://<github-username>.github.io
#   PUBLIC_BASE_PATH=/prestige-roofing-website
#
# Custom domain (e.g. prestigeroofingsolutions.com.au connected to Pages):
#   PUBLIC_SITE_URL=https://prestigeroofingsolutions.com.au
#   PUBLIC_BASE_PATH=/
#
# Contact form (Formspree). Create a form at https://formspree.io and paste
# the endpoint here, e.g. https://formspree.io/f/xxxxxx.
# Until this is set, the form shows the phone/email fallback (by design).
PUBLIC_FORMSPREE_ENDPOINT=

PUBLIC_SITE_URL=https://prestigeroofingsolutions.com.au
PUBLIC_BASE_PATH=/prestige-roofing-website
