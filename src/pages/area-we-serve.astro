---
/** Areas We Serve — full original content preserved (duplicate section deduplicated; see README). */
import { ArrowRight, MapPin } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/react/FAQAccordion";
import { href } from "../config/site";
import { areasIntro, serviceAreas, areasFaqs } from "../content/areas";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: areasFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Sydney Roofing Services by Suburb | Prestige Roofing — Areas We Serve"
  description="Prestige Roofing Solutions serves Greater Sydney: Hills Shire, Inner West, North Sydney, Sutherland Shire, Blue Mountains, Richmond & Windsor. Call +61 407 462 014."
  path="/area-we-serve/"
  schema={schema}
>
  <PageHero
    eyebrow="Where we work"
    title="Roofing services across Greater Sydney"
    intro="Based in Doonside, working across Sydney — properly inspected, properly quoted, fixed by licensed and insured roofers."
    trail={[{ label: "Areas We Serve" }]}
  />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-14 sm:pt-20" aria-label="Service area introduction">
    <div class="reveal prose-prestige text-muted leading-relaxed text-[1.02rem]">
      {areasIntro.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16" aria-label="Service areas">
    <div class="grid gap-6 lg:grid-cols-2">
      {serviceAreas.map((a, i) => (
        <article class={`reveal rounded-xl border border-line bg-white p-6 sm:p-8 ${i === serviceAreas.length - 1 ? "lg:col-span-2" : ""}`}>
          <h2 class="font-display text-2xl font-extrabold text-charcoal flex items-start gap-2.5">
            <MapPin size={22} class="text-copper-dark shrink-0 mt-1" aria-hidden="true" />
            {a.area}
          </h2>
          <p class="mt-1.5 text-[0.85rem] font-semibold text-copper-dark">{a.suburbs}</p>
          <div class="mt-4 space-y-3 text-muted leading-relaxed text-[0.95rem]">
            {a.body.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <a
            href={href("/get-a-quote/")}
            class="mt-5 inline-flex items-center gap-1.5 text-[0.9rem] font-bold text-copper-dark hover:gap-3 transition-all"
          >
            Get a quote in {a.area} <ArrowRight size={16} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <div class="reveal mt-6 rounded-xl bg-charcoal text-white p-6 sm:p-8 text-center">
      <h2 class="font-display text-2xl font-extrabold">Don't see your suburb listed?</h2>
      <p class="mt-2 text-white/70 leading-relaxed max-w-2xl mx-auto">
        The areas above are where we work most often, but our footprint across
        Sydney is wider than this list. Get in touch with your address and
        we'll tell you straight away whether we can help.
      </p>
      <a
        href={href("/contact-us/")}
        class="mt-5 inline-flex items-center gap-2 bg-copper font-display font-bold px-7 py-3.5 rounded-md hover:bg-copper-dark transition-colors"
      >
        Contact Us <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="bg-white border-t border-line" aria-labelledby="areas-faq-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-20">
      <div class="reveal text-center">
        <p class="eyebrow">Good to know</p>
        <h2 id="areas-faq-heading" class="mt-3 text-3xl sm:text-4xl font-extrabold text-charcoal">
          Frequently asked questions
        </h2>
      </div>
      <div class="reveal mt-8">
        <FAQAccordion faqs={areasFaqs} client:visible />
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
