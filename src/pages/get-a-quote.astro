---
/** Get a Quote — enquiry page (preserves original /get-a-quote/ URL). */
import { ClipboardCheck, MessagesSquare, Phone, ThumbsUp } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/react/ContactForm";
import { business } from "../config/site";
---

<BaseLayout
  title="Get a Quote | Prestige Roofing Solutions Sydney"
  description="Request a free roofing quote in Sydney — restoration, repairs, replacement, painting, guttering & more. Call +61 407 462 014 or send your details online."
  path="/get-a-quote/"
>
  <PageHero
    eyebrow="Free quotes"
    title="Get a quote"
    intro="Tell us about your roof. We'll inspect it, discuss your requirements and respond with a fair, written solution."
    trail={[{ label: "Get a Quote" }]}
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20" aria-label="Request a quote">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-12">
      <div>
        <h2 class="reveal font-display text-2xl sm:text-3xl font-extrabold text-charcoal">
          What happens next
        </h2>
        <ol class="mt-6 space-y-4">
          {[
            { icon: MessagesSquare, title: "1. Requirement discussion", body: "Send your details or call us — we listen first." },
            { icon: ClipboardCheck, title: "2. Inspection & planning", body: "We inspect your roof and plan the right solution." },
            { icon: Phone, title: "3. Fair written quote", body: "Deep communication before the quote — no surprises." },
            { icon: ThumbsUp, title: "4. Expert work, feedback first", body: "We perform the task with sincerity and check it with you." },
          ].map((s) => (
            <li class="reveal flex gap-4 bg-white border border-line rounded-xl p-5">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-copper-soft text-copper-dark shrink-0">
                <s.icon size={20} aria-hidden="true" />
              </span>
              <span>
                <span class="block font-display font-bold text-charcoal">{s.title}</span>
                <span class="block mt-1 text-[0.92rem] text-muted">{s.body}</span>
              </span>
            </li>
          ))}
        </ol>
        <div class="reveal mt-6 bg-charcoal text-white rounded-xl p-6">
          <p class="font-display font-bold">Prefer to talk directly?</p>
          <p class="mt-1.5 text-white/70 text-[0.93rem]">
            Mon – Fri: 07.00am – 05.00pm · Sat: 08.00am – 01.00pm
          </p>
          <a
            href={business.phoneHref}
            class="mt-4 inline-flex w-full items-center justify-center gap-2 bg-copper font-display font-bold px-6 py-3.5 rounded-md hover:bg-copper-dark transition-colors"
          >
            <Phone size={16} aria-hidden="true" /> {business.phone}
          </a>
        </div>
      </div>
      <div class="reveal bg-white border border-line rounded-xl p-6 sm:p-8 h-fit">
        <h2 class="font-display text-2xl font-extrabold text-charcoal">Submit your details</h2>
        <p class="mt-2 text-muted text-[0.95rem]">
          Fill in the form and we'll be back to you as soon as possible.
        </p>
        <div class="mt-6">
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
