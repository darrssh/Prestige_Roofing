---
/**
 * Service page template — one route renders all 12 original service URLs
 * (preserves URL structure, e.g. `/roof-replacement/`, `/colorbond-roof/`).
 */
import { ArrowRight, CheckCircle2, Phone } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/react/FAQAccordion";
import ServiceIcon from "../components/ServiceIcon.astro";
import { services, getService } from "../content/services";
import { business, href } from "../config/site";
import { canonicalFor } from "../utils/links";

export async function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug } }));
}

const { service } = Astro.params;
const data = getService(service ?? "");
if (!data) throw new Error(`Unknown service: ${service}`);

const related = services.filter((s) => s.slug !== data.slug).slice(0, 3);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${data.title} — ${business.name}`,
    description: data.metaDescription,
    provider: {
      "@type": "RoofingContractor",
      name: business.name,
      telephone: business.phone,
      address: {
        "@type": "PostalAddress",
        streetAddress: "22 Pembroke St, Blacktown NSW 2148",
        addressLocality: "Blacktown",
        addressRegion: "NSW",
        postalCode: "2148",
        addressCountry: "AU",
      },
    },
    areaServed: "Greater Sydney, NSW, Australia",
    url: canonicalFor(`/${data.slug}/`),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  path={`/${data.slug}/`}
  ogImage={data.image}
  schema={schema}
>
  <PageHero
    eyebrow={data.title}
    title={data.heroHeading}
    intro={data.heroSub}
    trail={[{ label: "Services", path: href("/services/") }, { label: data.title }]}
  />

  <!-- Intro + highlights -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20" aria-label={`${data.title} details`}>
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <div class="reveal">
        <div class="prose-prestige text-muted leading-relaxed text-[1.02rem]">
          {data.intro.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        {data.extraHeading && (
          <>
            <h2 class="mt-10 font-display text-2xl sm:text-3xl font-extrabold text-charcoal">
              {data.extraHeading}
            </h2>
            <div class="prose-prestige mt-4 text-muted leading-relaxed">
              {data.extraBody?.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </>
        )}
        {data.process && (
          <>
            <h2 class="mt-10 font-display text-2xl sm:text-3xl font-extrabold text-charcoal">
              How we deliver this service
            </h2>
            <ol class="mt-6 space-y-4">
              {data.process.map((step, i) => (
                <li class="flex gap-4 bg-white border border-line rounded-xl p-5">
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-charcoal text-copper font-display font-extrabold text-sm shrink-0">
                    {i + 1}
                  </span>
                  <span>
                    <span class="block font-display font-bold text-charcoal">{step.title}</span>
                    <span class="block mt-1 text-[0.93rem] text-muted leading-relaxed">{step.body}</span>
                  </span>
                </li>
              ))}
            </ol>
          </>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="reveal overflow-hidden rounded-xl border border-line bg-white">
          <img
            src={data.image}
            alt={data.imageAlt}
            class="h-56 w-full object-cover"
            loading="lazy"
            width="800"
            height="450"
          />
          <div class="p-6">
            <h2 class="font-display font-bold text-lg text-charcoal flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-copper-soft text-copper-dark">
                <ServiceIcon slug={data.slug} size={18} />
              </span>
              What's included
            </h2>
            <ul class="mt-4 space-y-2.5">
              {data.highlights.map((h) => (
                <li class="flex gap-2.5 text-[0.93rem] text-muted leading-relaxed">
                  <CheckCircle2 size={17} class="text-copper-dark shrink-0 mt-0.5" aria-hidden="true" />
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="reveal bg-charcoal text-white rounded-xl p-6">
          <h2 class="font-display font-bold text-lg">Get a free quote</h2>
          <p class="mt-2 text-[0.9rem] text-white/70 leading-relaxed">
            Tell us about your roof — we'll inspect it and respond with a fair,
            written solution.
          </p>
          <a
            href={href("/get-a-quote/")}
            class="mt-4 inline-flex w-full items-center justify-center gap-2 bg-copper font-display font-bold px-6 py-3.5 rounded-md hover:bg-copper-dark transition-colors"
          >
            Get a Quote <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a
            href={business.phoneHref}
            class="mt-2.5 inline-flex w-full items-center justify-center gap-2 border border-white/25 font-display font-bold px-6 py-3.5 rounded-md hover:border-copper hover:text-copper transition-colors"
          >
            <Phone size={16} aria-hidden="true" /> {business.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-white border-y border-line" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-20">
      <div class="reveal text-center">
        <p class="eyebrow">Good to know</p>
        <h2 id="faq-heading" class="mt-3 text-3xl sm:text-4xl font-extrabold text-charcoal">
          Frequently asked questions
        </h2>
      </div>
      <div class="reveal mt-8">
        <FAQAccordion faqs={data.faqs} client:visible />
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20" aria-label="Related services">
    <h2 class="reveal font-display text-2xl sm:text-3xl font-extrabold text-charcoal">
      Explore related services
    </h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((s) => (
        <ServiceCard
          slug={s.slug}
          title={s.title}
          description={s.heroSub}
          image={s.image}
          imageAlt={s.imageAlt}
        />
      ))}
    </div>
  </section>

  <CTASection />
</BaseLayout>
