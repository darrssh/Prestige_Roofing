---
/** Blog index — original article titles preserved; cards link to the full article. */
import { ArrowRight, ArrowUpRight, BookOpen } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import { href } from "../config/site";
import { blogPosts } from "../content/posts";

const localHref = (slug: string) => href(`/${slug}/`);
---

<BaseLayout
  title="Blog | Roofing Guides Sydney — Prestige Roofing Solutions"
  description="Roofing guides from Prestige Roofing Solutions Sydney: restoration, replacement, painting, repairs and choosing the right roofing company."
  path="/blog/"
>
  <PageHero
    eyebrow="Guides & insights"
    title="From the blog"
    intro="Practical roofing knowledge from Sydney specialists — maintenance, restoration, replacement and more."
    trail={[{ label: "Blog" }]}
  />
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20" aria-label="Blog articles">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((p) => (
        <article class="reveal bg-white border border-line rounded-xl p-6 sm:p-7 flex flex-col hover:shadow-xl hover:shadow-charcoal/10 hover:-translate-y-1 transition-all duration-300">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-copper-soft text-copper-dark">
            <BookOpen size={20} aria-hidden="true" />
          </span>
          <h2 class="mt-4 font-display text-lg font-bold text-charcoal leading-snug">
            {p.local ? (
              <a href={localHref(p.slug)} class="hover:text-copper-dark transition-colors">{p.title}</a>
            ) : (
              <a href={p.originalUrl} target="_blank" rel="noopener noreferrer" class="hover:text-copper-dark transition-colors">
                {p.title}
              </a>
            )}
          </h2>
          <p class="mt-2.5 text-[0.9rem] text-muted leading-relaxed flex-1">{p.excerpt}</p>
          {p.local ? (
            <a
              href={localHref(p.slug)}
              class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-bold text-copper-dark hover:gap-3 transition-all"
            >
              Read article <ArrowRight size={16} aria-hidden="true" />
            </a>
          ) : (
            <a
              href={p.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-bold text-copper-dark hover:gap-3 transition-all"
            >
              Read on prestigeroofingsolutions.com.au <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="reveal mt-8 text-[0.88rem] text-muted max-w-3xl">
      Note: full article bodies (apart from “What Is Roof Restoration?”, which
      is republished below in full) remain on the original website for now, so
      search engines and readers always find the complete text. Article URLs
      are preserved exactly.
    </p>
  </section>
  <CTASection />
</BaseLayout>
