---
/**
 * Contact Us — preserves original contact information, form fields and copy.
 */
import { Clock, Mail, MapPin, Phone } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/react/ContactForm";
import { business } from "../config/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Us — Prestige Roofing Solutions",
  description:
    "Contact the best roofing company in Sydney: head office, phone, email and enquiry form.",
};
---

<BaseLayout
  title="Contact Us | Best Roofing Company in Sydney — Prestige Roofing Solutions"
  description="Contact Prestige Roofing Solutions — 22 Pembroke St, Blacktown NSW 2148. Call +61 407 462 014 or email sales@prestigeroofingsolutions.com.au. We respond ASAP."
  path="/contact-us/"
  schema={schema}
>
  <PageHero
    eyebrow="Get in touch"
    title="Ask anything"
    intro="Prestige Roofing Solution is the best destination when you want to restore all goodness and enhance the longevity of your roof and home structure."
    trail={[{ label: "Contact Us" }]}
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20" aria-label="Contact details and enquiry form">
    <p class="reveal max-w-3xl text-muted leading-relaxed">
      Are you facing roofing problems? Are your home appearances getting dull
      and damaged? It's time to contact the best roofing service provider in
      the city — Prestige Roofing Solutions. We have years of experience in
      repairing and replacing roofs, gutter systems, roof ventilation,
      skylights, wash, and so many other services required for keeping the roof
      in good health.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.15fr] lg:gap-12">
      <!-- Info -->
      <div class="space-y-4">
        <a
          href="https://maps.app.goo.gl/xB6QY3dhcBbULC5b9"
          target="_blank"
          rel="noopener noreferrer"
          class="reveal flex gap-4 bg-white border border-line rounded-xl p-6 hover:shadow-lg hover:shadow-charcoal/5 transition-shadow"
        >
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-copper-soft text-copper-dark shrink-0">
            <MapPin size={21} aria-hidden="true" />
          </span>
          <span>
            <span class="block font-display font-bold text-charcoal">Head Office</span>
            <span class="block mt-1 text-muted text-[0.95rem]">{business.headOffice}</span>
            <span class="block mt-1 text-muted text-[0.85rem]">Also servicing from {business.officeSecondary}</span>
          </span>
        </a>
        <a
          href={business.phoneHref}
          class="reveal flex gap-4 bg-white border border-line rounded-xl p-6 hover:shadow-lg hover:shadow-charcoal/5 transition-shadow"
        >
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-copper-soft text-copper-dark shrink-0">
            <Phone size={21} aria-hidden="true" />
          </span>
          <span>
            <span class="block font-display font-bold text-charcoal">Contact Us</span>
            <span class="block mt-1 text-copper-dark font-semibold text-lg">{business.phone}</span>
          </span>
        </a>
        <div class="reveal flex gap-4 bg-white border border-line rounded-xl p-6">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-copper-soft text-copper-dark shrink-0">
            <Mail size={21} aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block font-display font-bold text-charcoal">Email Us</span>
            <a href={`mailto:${business.emailSales}`} class="block mt-1 text-copper-dark font-semibold break-all">{business.emailSales}</a>
            <a href={`mailto:${business.emailAdmin}`} class="block mt-0.5 text-muted text-[0.9rem] break-all">{business.emailAdmin}</a>
          </span>
        </div>
        <div class="reveal flex gap-4 bg-white border border-line rounded-xl p-6">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-copper-soft text-copper-dark shrink-0">
            <Clock size={21} aria-hidden="true" />
          </span>
          <span>
            <span class="block font-display font-bold text-charcoal">Working Hours</span>
            <span class="block mt-1 text-muted text-[0.95rem]">
              Mon – Fri: 07.00am – 05.00pm<br />Sat: 08.00am – 01.00pm
            </span>
          </span>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal bg-white border border-line rounded-xl p-6 sm:p-8 h-fit">
        <h2 class="font-display text-2xl font-extrabold text-charcoal">Send your details</h2>
        <p class="mt-2 text-muted text-[0.95rem] leading-relaxed">
          Just call us at {business.phone} or email at {business.emailSales} —
          we will be back to you as soon as possible.
        </p>
        <div class="mt-6">
          <ContactForm client:visible />
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="reveal mt-10 overflow-hidden rounded-xl border border-line">
      <iframe
        title="Map — Prestige Roofing Solutions head office, Blacktown NSW"
        src={business.mapsEmbed}
        class="w-full h-[380px] border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</BaseLayout>
