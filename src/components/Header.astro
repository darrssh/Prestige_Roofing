---
/** Premium header: top info bar + sticky nav with services dropdown + mobile menu. */
import { Clock, Mail, MapPin, Phone, ChevronDown, Menu, X } from "lucide-react";
import Logo from "./Logo.astro";
import { business, href, navigation } from "../config/site";

const current = Astro.url.pathname;
const isActive = (link: string) => {
  const base = import.meta.env.BASE_URL ?? "/";
  const strip = (p: string) => p.replace(new RegExp(`^${base.replace(/\//g, "\\/")}`), "/");
  const here = strip(current);
  const there = strip(link);
  if (there === "/") return here === "/";
  return here === there || here.startsWith(there);
};
---

<!-- Top information bar -->
<div class="bg-charcoal-deep text-white/80 text-[0.8rem]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center justify-between gap-4 py-2">
    <p class="hidden md:flex items-center gap-2 min-w-0">
      <MapPin size={14} class="text-copper shrink-0" aria-hidden="true" />
      <span class="truncate">{business.headOffice}</span>
    </p>
    <p class="flex md:hidden items-center gap-2">
      <Clock size={14} class="text-copper shrink-0" aria-hidden="true" />
      <span>{business.hoursShort}</span>
    </p>
    <div class="flex items-center gap-4 sm:gap-5">
      <span class="hidden lg:flex items-center gap-2">
        <Clock size={14} class="text-copper shrink-0" aria-hidden="true" />
        {business.hoursShort}
      </span>
      <a href={`mailto:${business.emailSales}`} class="hidden sm:flex items-center gap-2 hover:text-white transition-colors">
        <Mail size={14} class="text-copper shrink-0" aria-hidden="true" />
        {business.emailSales}
      </a>
      <a href={business.phoneHref} class="flex items-center gap-2 font-semibold text-white hover:text-copper transition-colors">
        <Phone size={14} class="text-copper shrink-0" aria-hidden="true" />
        {business.phone}
      </a>
    </div>
  </div>
</div>

<!-- Main navigation -->
<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-line">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="flex items-center justify-between h-[72px]" aria-label="Primary">
      <a href={href("/")} aria-label="Prestige Roofing Solutions — home">
        <Logo />
      </a>

      <!-- Desktop -->
      <ul class="hidden lg:flex items-center gap-1">
        {navigation.map((item) => (
          <li class={item.children ? "relative group" : ""}>
            {item.children ? (
              <>
                <a
                  href={item.href}
                  aria-haspopup="true"
                  class={`flex items-center gap-1 px-3.5 py-2.5 text-[0.92rem] font-semibold rounded-md transition-colors ${isActive(item.href) ? "text-copper-dark" : "text-slate-text hover:text-copper-dark"}`}
                >
                  {item.label}
                  <ChevronDown size={15} class="transition-transform group-hover:rotate-180" aria-hidden="true" />
                </a>
                <div class="absolute left-0 top-full pt-1 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
                  <ul class="w-64 bg-white border border-line rounded-xl shadow-xl shadow-charcoal/10 p-2">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="block px-3.5 py-2.5 text-[0.9rem] font-medium text-slate-text rounded-lg hover:bg-cream hover:text-copper-dark transition-colors"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class={`px-3.5 py-2.5 text-[0.92rem] font-semibold rounded-md transition-colors ${isActive(item.href) ? "text-copper-dark" : "text-slate-text hover:text-copper-dark"}`}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="hidden lg:block">
        <a
          href={href("/get-a-quote/")}
          class="inline-flex items-center bg-charcoal text-white font-display font-bold text-[0.92rem] px-6 py-3 rounded-md hover:bg-copper-dark transition-colors"
        >
          Get a Quote
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-md border border-line text-charcoal"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span id="menu-icon-open"><Menu size={22} /></span>
        <span id="menu-icon-close" class="hidden"><X size={22} /></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-line bg-cream max-h-[calc(100vh-72px)] overflow-y-auto">
    <ul class="px-4 py-3 space-y-0.5">
      {navigation.map((item) => (
        <li>
          {item.children ? (
            <details class="group rounded-lg">
              <summary class="flex items-center justify-between px-3 py-3 font-display font-bold text-slate-text cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <a href={item.href}>{item.label}</a>
                <ChevronDown size={17} class="text-muted group-open:rotate-180 transition-transform" aria-hidden="true" />
              </summary>
              <ul class="pb-2 pl-2 space-y-0.5">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block px-3 py-2.5 text-[0.95rem] font-medium text-slate-text/90 border-l-2 border-line hover:border-copper hover:text-copper-dark">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block px-3 py-3 font-display font-bold text-slate-text">
              {item.label}
            </a>
          )}
        </li>
      ))}
      <li class="pt-2 pb-3 px-1">
        <a
          href={href("/get-a-quote/")}
          class="flex items-center justify-center bg-charcoal text-white font-display font-bold px-6 py-3.5 rounded-md"
        >
          Get a Quote
        </a>
        <a
          href={business.phoneHref}
          class="mt-2 flex items-center justify-center gap-2 border border-charcoal/20 font-display font-bold px-6 py-3.5 rounded-md text-charcoal"
        >
          <Phone size={16} aria-hidden="true" /> {business.phone}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  });
  // Close mobile menu on navigation
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }),
  );
</script>
