---
/** Service card for grids — image, icon, title, description, link. */
import { ArrowRight } from "lucide-react";
import { serviceHref } from "../utils/links";
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
}
const { slug, title, description, image, imageAlt } = Astro.props;
---

<article class="reveal group bg-white border border-line rounded-xl overflow-hidden flex flex-col hover:shadow-xl hover:shadow-charcoal/10 hover:-translate-y-1 transition-all duration-300">
  <a href={serviceHref(slug)} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt=""
      loading="lazy"
      width="800"
      height="500"
      class="h-48 w-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
    />
  </a>
  <div class="p-6 flex flex-col flex-1">
    <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-copper-soft text-copper-dark -mt-11 mb-4 relative border-4 border-white">
      <ServiceIcon slug={slug} size={20} />
    </span>
    <h3 class="text-xl font-bold text-charcoal">
      <a href={serviceHref(slug)} class="hover:text-copper-dark transition-colors">
        {title}
      </a>
    </h3>
    <p class="mt-2.5 text-[0.93rem] leading-relaxed text-muted flex-1">{description}</p>
    <a
      href={serviceHref(slug)}
      class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-bold text-copper-dark hover:gap-3 transition-all"
      aria-label={`More details about ${title}`}
    >
      More details <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
  <span class="sr-only">{imageAlt}</span>
</article>
