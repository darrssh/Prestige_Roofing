---
/** Interior page hero — charcoal band with eyebrow, title and intro. */
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  trail: { label: string; path?: string }[];
}
const { eyebrow, title, intro, trail } = Astro.props;
---

<section class="bg-charcoal text-white relative overflow-hidden">
  <div
    class="absolute inset-0 opacity-[0.14]"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 85% 20%, #C8874B 0, transparent 42%), radial-gradient(circle at 10% 90%, #C8874B 0, transparent 35%);"
  ></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-14 sm:py-20">
    <Breadcrumbs trail={trail} />
    <p class="eyebrow mt-6">{eyebrow}</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-white max-w-3xl leading-[1.08]">
      {title}
    </h1>
    {intro && (
      <p class="mt-5 text-lg text-white/70 max-w-2xl leading-relaxed">{intro}</p>
    )}
  </div>
  <div class="h-1 bg-copper" aria-hidden="true"></div>
</section>
